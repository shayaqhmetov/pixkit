; Publish/install @pixkit exclusively against the public npm registry.
; (Do NOT route @pixkit through any private CodeArtifact registry.)
registry=https://registry.npmjs.org/
@pixkit:registry=https://registry.npmjs.org/

; Auth for npmjs. Reads NODE_AUTH_TOKEN from the environment (provided at publish
; time). The @pixkit:registry pin + per-package publishConfig.registry above keep
; @pixkit on public npm even if this env var is unset for non-publish commands.
//registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}

; Only allow pnpm
engine-strict=true
