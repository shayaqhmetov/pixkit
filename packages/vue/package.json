{
    "name": "@pixkit/vue",
    "version": "0.2.1",
    "description": "Pixel-art themed Vue UI components",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "styles",
        "src",
        "README.md"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./src": "./src/index.ts",
        "./styles/index.css": "./styles/index.css",
        "./styles/qurbaqa.css": "./styles/qurbaqa.css",
        "./styles/qurbaqa-fonts.css": "./styles/qurbaqa-fonts.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
        "typecheck": "vue-tsc --noEmit"
    },
    "peerDependencies": {
        "vue": ">=3.4"
    },
    "dependencies": {
        "@pixkit/tokens": "workspace:*"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.1.0",
        "vite": "^5.4.0",
        "vue": "^3.5.0",
        "vue-tsc": "^2.1.0"
    },
    "keywords": [
        "vue",
        "components",
        "ui",
        "pixel-art",
        "retro",
        "design-system"
    ],
    "author": "Ruslan Shayakhmetov",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/shayaqhmetov/pixkit.git",
        "directory": "packages/vue"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
